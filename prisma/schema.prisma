generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MaterialType {
  LECTURE_NOTES
  SLIDES
  QUESTION_BANK
  LAB_MANUAL
  ASSIGNMENT
  REFERENCE_MATERIAL
  PAST_PAPER
  OTHER
}

enum MaterialVisibility {
  EVERYONE
  DEPARTMENT_PROGRAM
  CLASSES
}

model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  passwordHash          String
  firstName             String
  lastName              String
  role                  Role
  status                UserStatus      @default(ACTIVE)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  student               Student?
  teacher               Teacher?
  authoredAnnouncements Announcement[]
  uploadedMaterials     StudyMaterial[]
  bookmarks             Bookmark[]
}

model Program {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  durationYears  Int             @default(4)
  departmentName String
  students       Student[]
  subjects       Subject[]
  classes        Class[]
  assessments    Assessment[]
  curriculum     Curriculum?
  studyMaterials StudyMaterial[]
  syllabi        Syllabus[]
  announcements  Announcement[]
}

model Student {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  enrollmentNumber        String             @unique
  registrationId          String             @unique
  rollNumber              String?            @unique
  profileImageUrl         String?
  programId               String?
  currentSemester         Int?               @default(1)
  admissionDate           DateTime
  programEnrollmentStatus String             @default("ENROLLED")
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  program                 Program?           @relation(fields: [programId], references: [id], onDelete: SetNull)
  attendanceRecords       AttendanceRecord[]
  results                 Result[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([programId])
  @@index([currentSemester])
}

model Teacher {
  id              String           @id @default(cuid())
  userId          String           @unique
  employeeNo      String           @unique
  profileImageUrl String?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes         Class[]
  announcements   Announcement[]
  subjectTeachers SubjectTeacher[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Subject {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  programId       String
  semester        Int              @default(1)
  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  classes         Class[]
  assessments     Assessment[]
  studyMaterials  StudyMaterial[]
  announcements   Announcement[]
  subjectTeachers SubjectTeacher[]

  @@unique([programId, semester, code])
  @@index([programId, semester])
}

/**
 * Many-to-many assignment of teachers to subjects. This is the source of
 * truth for "who teaches what": class schedule slots derive their teacher
 * from these rows automatically instead of picking one from the full faculty
 * list. A subject may list several teachers (e.g. parallel practical groups).
 */
model SubjectTeacher {
  id        String   @id @default(cuid())
  subjectId String
  teacherId String
  createdAt DateTime @default(now())
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId])
  @@index([teacherId])
}

model Class {
  id        String               @id @default(cuid())
  subjectId String
  teacherId String
  programId String
  semester  Int                  @default(1)
  dayOfWeek DayOfWeek
  startTime DateTime             @db.Time
  endTime   DateTime             @db.Time
  type      String               @default("Lecture") // "Lecture" | "Practical"
  group     String? // e.g. "Gr. A" — allows parallel practical groups
  subject   Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher   Teacher              @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  program   Program              @relation(fields: [programId], references: [id], onDelete: Restrict)
  sessions  AttendanceSession[]
  materials StudyMaterialClass[]

  @@unique([subjectId, teacherId, programId, semester, dayOfWeek, startTime, endTime])
  @@index([teacherId, semester, dayOfWeek])
}

model AttendanceSession {
  id          String             @id @default(cuid())
  classId     String
  sessionDate DateTime           @db.Date
  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  records     AttendanceRecord[]

  @@unique([classId, sessionDate])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus
  note      String?
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId, status])
}

model Assessment {
  id             String    @id @default(cuid())
  subjectId      String
  programId      String
  semester       Int       @default(1)
  name           String
  maxMarks       Decimal   @db.Decimal(6, 2)
  assessmentDate DateTime?
  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  program        Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  results        Result[]

  @@unique([subjectId, semester, name])
  @@index([programId, semester])
}

model Result {
  id           String     @id @default(cuid())
  assessmentId String
  studentId    String
  marks        Decimal    @db.Decimal(6, 2)
  grade        String?
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  publishedAt DateTime?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Teacher-scoped notices: when `teacherId` is set the notice targets a
  // specific teaching group (subject × program × semester) instead of the
  // whole campus. `authorId` always points at the publishing User so cards
  // can render the author byline for both admins and teachers.
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  semester  Int?

  // Optional attachment (e.g. a notice image/PDF), stored in Postgres like
  // other uploads so the app stays self-contained with the pg adapter.
  attachmentFileName String?
  attachmentMimeType String?
  attachmentSize     Int?
  attachmentData     Bytes?

  @@index([publishedAt])
  @@index([teacherId])
  @@index([programId, semester])
}

// ─── Curriculum (admin-manageable course structure) ─────────────
model Curriculum {
  id        String               @id @default(cuid())
  programId String               @unique
  program   Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  years     CurriculumYear[]
  electives CurriculumElective[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model CurriculumYear {
  id           String               @id @default(cuid())
  curriculumId String
  curriculum   Curriculum           @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  yearNo       Int
  label        String
  semesters    CurriculumSemester[]

  @@unique([curriculumId, yearNo])
}

model CurriculumSemester {
  id         String             @id @default(cuid())
  yearId     String
  year       CurriculumYear     @relation(fields: [yearId], references: [id], onDelete: Cascade)
  semesterNo Int
  label      String
  courses    CurriculumCourse[]

  @@unique([yearId, semesterNo])
}

model CurriculumCourse {
  id         String             @id @default(cuid())
  semesterId String
  semester   CurriculumSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  code       String?
  name       String
  credits    Int                @default(3)
  sortOrder  Int                @default(0)

  @@index([semesterId])
}

model CurriculumElective {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  group        String // "ELECTIVE_I" | "ELECTIVE_II"
  code         String?
  name         String
  credits      Int        @default(3)
  sortOrder    Int        @default(0)

  @@index([curriculumId, group])
}

// ─── Notes / Study Materials library ────────────────────────────
model StudyMaterial {
  id             String             @id @default(cuid())
  title          String
  description    String?
  topic          String?
  materialType   MaterialType       @default(LECTURE_NOTES)
  visibility     MaterialVisibility @default(EVERYONE)
  departmentName String?
  programId      String?
  semester       Int?
  subjectId      String?
  fileName       String
  mimeType       String?
  fileSize       Int // bytes
  fileData       Bytes // stored in Postgres — keeps uploads self-contained with pg adapter
  uploaderId     String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  program    Program?             @relation(fields: [programId], references: [id], onDelete: SetNull)
  subject    Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  uploader   User                 @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  classLinks StudyMaterialClass[]
  bookmarks  Bookmark[]

  @@index([materialType])
  @@index([visibility])
  @@index([programId, semester])
  @@index([subjectId])
  @@index([uploaderId])
  @@index([createdAt])
}

// Targets a whole teaching group (all schedule slots of a subject for a program/semester)
model StudyMaterialClass {
  id         String        @id @default(cuid())
  materialId String
  classId    String
  material   StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  class      Class         @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([materialId, classId])
  @@index([classId])
}

model Bookmark {
  id              String        @id @default(cuid())
  userId          String
  studyMaterialId String
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyMaterial   StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)

  @@unique([userId, studyMaterialId])
  @@index([studyMaterialId])
}

// ─── Syllabus library (admin-uploaded PDF syllabi, publicly readable) ─────
model Syllabus {
  id             String   @id @default(cuid())
  title          String? // null => derived from file name
  departmentName String
  programId      String?
  semester       Int // 1..8
  fileName       String
  mimeType       String?
  fileSize       Int // bytes
  fileData       Bytes // stored in Postgres — keeps uploads self-contained with pg adapter
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([departmentName])
  @@index([programId, semester])
  @@index([semester])
  @@index([createdAt])
}
