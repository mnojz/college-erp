generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model User {
  id                   String        @id @default(cuid())
  email                String        @unique
  passwordHash         String
  firstName            String
  lastName             String
  role                 Role
  status               UserStatus    @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  student              Student?
  teacher              Teacher?
  authoredAnnouncements Announcement[]
}

model Department {
  id         String    @id @default(cuid())
  name       String
  code       String    @unique
  createdAt  DateTime  @default(now())
  programs   Program[]
  courses    Course[]
  teachers   Teacher[]
}

model Program {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  durationYears Int
  departmentId String
  department  Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  students    Student[]
  offerings   CourseOffering[]
  feeStructures FeeStructure[]
}

model Student {
  id           String       @id @default(cuid())
  userId       String       @unique
  admissionNo  String       @unique
  rollNumber   String?      @unique
  profileImageUrl String?
  programId    String?
  admissionDate DateTime
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  attendance   AttendanceRecord[]
  results      Result[]
  fees         StudentFee[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([programId])
}

model Teacher {
  id           String       @id @default(cuid())
  userId       String       @unique
  employeeNo   String       @unique
  departmentId String?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  offerings    CourseOffering[]
  attendanceSessions AttendanceSession[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([departmentId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startsOn  DateTime
  endsOn    DateTime
  terms     Term[]
}

model Term {
  id             String          @id @default(cuid())
  name           String
  number         Int
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  offerings      CourseOffering[]
  feeStructures  FeeStructure[]

  @@unique([academicYearId, number])
}

model Course {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  credits      Int
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  offerings    CourseOffering[]
}

model CourseOffering {
  id          String          @id @default(cuid())
  courseId    String
  termId      String
  programId   String?
  teacherId   String
  section     String          @default("A")
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term        Term            @relation(fields: [termId], references: [id], onDelete: Cascade)
  program     Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  teacher     Teacher         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]
  attendanceSessions AttendanceSession[]
  assessments Assessment[]

  @@unique([courseId, termId, section])
  @@index([teacherId, termId])
}

model Enrollment {
  id          String           @id @default(cuid())
  studentId   String
  offeringId  String
  status      EnrollmentStatus @default(ENROLLED)
  enrolledAt  DateTime         @default(now())
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offering    CourseOffering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([studentId, offeringId])
  @@index([offeringId, status])
}

model AttendanceSession {
  id          String             @id @default(cuid())
  offeringId  String
  teacherId   String
  heldAt      DateTime
  offering    CourseOffering    @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  teacher     Teacher           @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  records     AttendanceRecord[]

  @@unique([offeringId, heldAt])
  @@index([teacherId, heldAt])
}

model AttendanceRecord {
  id          String             @id @default(cuid())
  sessionId   String
  studentId   String
  status      AttendanceStatus
  note        String?
  session     AttendanceSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId, status])
}

model Assessment {
  id          String       @id @default(cuid())
  offeringId  String
  name        String
  maxMarks    Decimal      @db.Decimal(6, 2)
  assessmentDate DateTime?
  offering    CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  results     Result[]

  @@unique([offeringId, name])
}

model Result {
  id           String     @id @default(cuid())
  assessmentId String
  studentId    String
  marks        Decimal    @db.Decimal(6, 2)
  grade        String?
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  isPublic    Boolean  @default(false)
  publishedAt DateTime?
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublic, publishedAt])
}

model FeeStructure {
  id          String        @id @default(cuid())
  name        String
  amount      Decimal       @db.Decimal(12, 2)
  programId   String?
  termId      String?
  program     Program?      @relation(fields: [programId], references: [id], onDelete: Cascade)
  term        Term?         @relation(fields: [termId], references: [id], onDelete: Cascade)
  studentFees StudentFee[]

  @@index([programId, termId])
}

model StudentFee {
  id             String        @id @default(cuid())
  studentId      String
  feeStructureId String
  amountDue      Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  dueDate        DateTime?
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure   FeeStructure  @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)

  @@unique([studentId, feeStructureId])
  @@index([studentId, dueDate])
}

