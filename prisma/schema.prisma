generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Verification state of a user's submitted profile changes.
/// APPROVED is the default so existing users are unaffected. A user who edits a
/// self-service field (address, guardian, phone…) or uploads a new profile
/// picture stages it as PENDING_REVIEW; an admin then approves (the changes go
/// live) or rejects (they are discarded and the previous values are kept).
enum ProfileReviewStatus {
  APPROVED
  PENDING_REVIEW
  REJECTED
}

/// Which exam event a session belongs to. Written vs practical is driven by the
/// per-ExamSubject `part`, not this enum: an END_SEMESTER session carries both
/// THEORY (admin-entered, written) and PRACTICAL (teacher-entered) papers.
enum ExamType {
  END_SEMESTER
  MID_TERM
}

/// Lifecycle of an ExamSession. Transitions are admin-driven:
///   DRAFT → ANNOUNCED (routine published) → RESULTS_PUBLISHED (marks published)
enum ExamSessionStatus {
  DRAFT
  ANNOUNCED
  RESULTS_PUBLISHED
}

/// Which paper of a subject an ExamSubject row covers: TH (written) and PR
/// (practical/viva/lab) are independent papers — a subject may carry one or
/// both — so a student passes or fails each part separately while the other
/// stays intact.
enum SubjectExamKind {
  THEORY
  PRACTICAL
}

model User {
  id                    String           @id @default(cuid())
  email                 String           @unique
  passwordHash          String
  firstName             String
  lastName              String
  role                  Role
  status                UserStatus       @default(ACTIVE)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  /// Base64 data-URL of the profile picture awaiting admin review (mirrors the
  /// app's existing profileImageUrl storage convention). Cleared on
  /// approve/reject.
  pendingAvatarUrl      String?
  /// Self-service profile fields (address, guardian, phone…) awaiting admin
  /// review, stored as a partial { Student column: value } map containing only
  /// the CHANGED fields. Applied to the Student row on approve, discarded on
  /// reject.
  pendingProfileData    Json?
  profileReviewStatus   ProfileReviewStatus @default(APPROVED)
  /// Timestamp of the last rejected profile PICTURE submission. Distinct from
  /// profileReviewStatus (shared with data edits) so the picture uploader only
  /// shows "rejected" when a picture specifically was — not on a data-only reject.
  lastAvatarRejectedAt  DateTime?
  /// Forgot-password OTP. Only the SHA-256 hash is stored — the plaintext
  /// code exists solely in the emailed message.
  resetOtpHash          String?
  /// When the current OTP stops being accepted (10-minute TTL).
  resetOtpExpiresAt     DateTime?
  /// Failed verification attempts against the current OTP (capped at 5).
  resetOtpAttempts      Int       @default(0)
  /// Last OTP email send, used for the 60-second resend cooldown.
  resetOtpSentAt        DateTime?
  /// OTP emails sent within the rolling 1-hour window anchored at resetOtpSentAt.
  resetOtpSendCount     Int       @default(0)
  authoredAnnouncements Announcement[]
  bookmarks             Bookmark[]
  notifications         Notification[]
  privacySettings       ProfilePrivacy[]
  student               Student?
  uploadedMaterials     StudyMaterial[]
  teacher               Teacher?

  @@index([profileReviewStatus])
}

model Department {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  programs  Program[]
}

model Program {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  durationYears  Int             @default(4)
  departmentName String
  departmentId   String?
  archivedAt     DateTime?
  archivedBy     String?
  announcements  Announcement[]
  breaks         Break[]
  classes        Class[]
  curriculum     Curriculum?
  department     Department?     @relation(fields: [departmentId], references: [id])
  examSessions   ExamSession[]
  students       Student[]
  studyMaterials StudyMaterial[]
  subjects       Subject[]
  syllabi        Syllabus[]
}

model Student {
  id                 String             @id @default(cuid())
  userId             String             @unique
  enrollmentNumber   String             @unique
  registrationId     String             @unique
  rollNumber         Int?
  profileImageUrl    String?
  programId          String?
  admissionDate      DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  currentSemester    Int?               @default(1)
  bloodGroup         String?
  category           String?
  emergencyContact   String?
  gender             String?
  guardianEmail      String?
  guardianPhone      String?
  guardianRelation   String?
  nationality        String?
  phone              String?
  religion           String?
  status             StudentStatus      @default(ACTIVE)
  currDistrictId     Int?
  currDistrictName   String?
  currLocalLevelId   Int?
  currLocalLevelName String?
  currLocalLevelType String?
  currProvinceId     Int?
  currProvinceName   String?
  currSameAsPerm     Boolean            @default(true)
  currTole           String?
  currWard           Int?
  permDistrictId     Int?
  permDistrictName   String?
  permLocalLevelId   Int?
  permLocalLevelName String?
  permLocalLevelType String?
  permProvinceId     Int?
  permProvinceName   String?
  permTole           String?
  permWard           Int?
  guardianName       String?
  attendanceRecords  AttendanceRecord[]
  examMarks          ExamMark[]
  examRegistrations  ExamRegistration[]
  program            Program?           @relation(fields: [programId], references: [id])
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentSemesters   StudentSemester[]

  // Roll numbers are per CLASS (program + semester): the same roll may exist
  // in other classes. enrollmentNumber/registrationId stay globally unique.
  @@unique([programId, currentSemester, rollNumber])
  @@index([programId])
  @@index([currentSemester])
}

model Teacher {
  id              String           @id @default(cuid())
  userId          String           @unique
  employeeNo      String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profileImageUrl String?
  bio             String?
  office          String?
  phone           String?
  qualification   String?
  announcements   Announcement[]
  classes         Class[]
  subjectTeachers SubjectTeacher[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  programId       String
  semester        Int              @default(1)
  credits         Int              @default(3)
  /// Which papers this subject carries, set by the admin on the course
  /// structure page. TH (written) and PR (practical/viva/lab) are independent:
  /// a subject may be TH-only, PR-only, or both — each present part becomes a
  /// separate ExamSubject row (its own marks and pass/fail) in a session.
  hasTheory       Boolean          @default(true)
  hasPractical    Boolean          @default(false)
  announcements   Announcement[]
  classes         Class[]
  examSubjects    ExamSubject[]
  routineEntries  ExamRoutineEntry[]
  studyMaterials  StudyMaterial[]
  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  subjectTeachers SubjectTeacher[]

  @@unique([programId, semester, code])
  @@index([programId, semester])
}

/// *
/// * Many-to-many assignment of teachers to subjects. This is the source of
/// * truth for "who teaches what": class schedule slots derive their teacher
/// * from these rows automatically instead of picking one from the full faculty
/// * list. A subject may list several teachers (e.g. parallel practical groups).
model SubjectTeacher {
  id        String   @id @default(cuid())
  subjectId String
  teacherId String
  createdAt DateTime @default(now())
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId])
  @@index([teacherId])
}

/// *
/// * In-app notification for a single recipient (user). Created by system
/// * events: campus announcements, teacher class notices, material uploads,
/// * assessments, published results, timetable changes, subject assignments.
/// * `link` is the dashboard path the recipient is taken to on click.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Class {
  id        String               @id @default(cuid())
  subjectId String
  teacherId String?
  programId String
  dayOfWeek DayOfWeek
  startTime DateTime             @db.Time(6)
  endTime   DateTime             @db.Time(6)
  semester  Int                  @default(1)
  group     String?
  type      String               @default("Lecture")
  sessions  AttendanceSession[]
  program   Program              @relation(fields: [programId], references: [id])
  subject   Subject              @relation(fields: [subjectId], references: [id])
  teacher   Teacher?             @relation(fields: [teacherId], references: [id])
  materials StudyMaterialClass[]

  @@unique([subjectId, teacherId, programId, semester, dayOfWeek, startTime, endTime])
  @@index([teacherId, semester, dayOfWeek])
}

model Break {
  id        String   @id @default(cuid())
  programId String
  semester  Int      @default(1)
  startTime DateTime @db.Time(6)
  endTime   DateTime @db.Time(6)
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, semester])
  @@index([programId])
}

model AttendanceSession {
  id          String             @id @default(cuid())
  classId     String
  sessionDate DateTime           @db.Date
  createdAt   DateTime           @default(now())
  records     AttendanceRecord[]
  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, sessionDate])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus
  note      String?
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId, status])
}

/// One exam event for a cohort: (program, semester, academic year, type).
/// Admin-created only. An END_SEMESTER session carries both THEORY (written,
/// admin-entered) and PRACTICAL (teacher-entered) papers in one marking table.
/// Status moves DRAFT → ANNOUNCED (routine published to students) →
/// RESULTS_PUBLISHED (marks published, students notified).
model ExamSession {
  id                 String            @id @default(cuid())
  programId          String
  semester           Int
  academicYearId     String?
  type               ExamType
  title              String
  status             ExamSessionStatus @default(DRAFT)
  routinePublishedAt DateTime?
  routinePublishedBy String?
  /// Admin-set cutoff for the exam registration form: students may submit,
  /// edit and resubmit until this instant; after it the form is locked.
  /// Required before the routine can be announced (null only for sessions
  /// announced before the deadline feature existed).
  registrationDeadline DateTime?
  resultsPublishedAt DateTime?
  resultsPublishedBy String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  program            Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear?     @relation(fields: [academicYearId], references: [id])
  subjects           ExamSubject[]
  routine            ExamRoutineEntry[]

  @@unique([programId, semester, academicYearId, type])
  @@index([programId, semester])
  @@index([status])
}

/// A subject part included in an exam session, with its full marks and whether
/// its marks have been finalized (teacher-published) — a gate on publishing
/// results. `part` makes theory and practical independent: a both-component
/// subject produces two rows (TH + PR) in the same session, each with its own
/// marks, pass/fail and registration set.
model ExamSubject {
  id               String       @id @default(cuid())
  sessionId        String
  subjectId        String
  /// TH = written paper, PR = practical/viva/lab. Drives who enters marks
  /// (admin enters TH in an END_SEMESTER session, teachers enter PR and all
  /// MID_TERM papers), the default full marks, and per-part registration.
  part             SubjectExamKind @default(THEORY)
  maxMarks         Decimal      @db.Decimal(6, 2)
  marksPublishedAt DateTime?
  marksPublishedBy String?
  session          ExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject          Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks            ExamMark[]
  registrations    ExamRegistration[]

  @@unique([sessionId, subjectId, part])
  @@index([subjectId])
}

/// One row of the exam routine: a date paired with a subject. Dates are entered
/// manually by the admin (gaps of 2–4 days between papers are their choice),
/// `order` gives the day sequence shown to students.
model ExamRoutineEntry {
  id        String      @id @default(cuid())
  sessionId String
  subjectId String?
  date      DateTime    @db.Date
  order     Int
  session   ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject   Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([sessionId, order])
}

/// A student's mark for one subject in one exam session. Grade and grade point
/// are computed server-side from marks vs maxMarks (app/lib/grading.ts), so a
/// tampered client can never store an inconsistent grade. Every cell of the
/// big admin marking table and every teacher-entered subject writes here.
model ExamMark {
  id            String      @id @default(cuid())
  examSubjectId String
  studentId     String
  marks         Decimal     @db.Decimal(6, 2)
  grade         String?
  gradePoint    Decimal?    @db.Decimal(3, 2)
  enteredBy     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, studentId])
  @@index([studentId])
}

/// A student's exam form submission: one row per (student, subject part) they
/// choose to appear for. Students are NOT auto-admitted — marking tables and
/// the publish gate only cover registered students. The form may be submitted,
/// edited and resubmitted any number of times until the session's
/// `registrationDeadline`, then locked.
model ExamRegistration {
  id            String      @id @default(cuid())
  studentId     String
  examSubjectId String
  createdAt     DateTime    @default(now())
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, studentId])
  @@index([studentId])
}

model Announcement {
  id                 String    @id @default(cuid())
  title              String
  body               String
  publishedAt        DateTime?
  authorId           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  attachmentData     Bytes?
  attachmentFileName String?
  attachmentMimeType String?
  attachmentSize     Int?
  programId          String?
  semester           Int?
  subjectId          String?
  teacherId          String?
  archivedAt         DateTime?
  archivedBy         String?
  author             User?     @relation(fields: [authorId], references: [id])
  program            Program?  @relation(fields: [programId], references: [id])
  subject            Subject?  @relation(fields: [subjectId], references: [id])
  teacher            Teacher?  @relation(fields: [teacherId], references: [id])

  @@index([publishedAt])
  @@index([teacherId])
  @@index([programId, semester])
  @@index([archivedAt])
}

model Curriculum {
  id        String               @id @default(cuid())
  programId String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  program   Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  electives CurriculumElective[]
  years     CurriculumYear[]
}

model CurriculumYear {
  id           String               @id @default(cuid())
  curriculumId String
  yearNo       Int
  label        String
  semesters    CurriculumSemester[]
  curriculum   Curriculum           @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, yearNo])
}

model CurriculumSemester {
  id         String             @id @default(cuid())
  yearId     String
  semesterNo Int
  label      String
  courses    CurriculumCourse[]
  year       CurriculumYear     @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@unique([yearId, semesterNo])
}

model CurriculumCourse {
  id         String             @id @default(cuid())
  semesterId String
  code       String?
  name       String
  credits    Int                @default(3)
  sortOrder  Int                @default(0)
  /// Admin toggles on the course structure page: which papers this course has.
  /// At least one must stay checked; curriculum-sync copies them onto Subject.
  hasTheory    Boolean             @default(true)
  hasPractical Boolean             @default(false)
  semester   CurriculumSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([semesterId])
}

model CurriculumElective {
  id           String     @id @default(cuid())
  curriculumId String
  group        String
  code         String?
  name         String
  credits      Int        @default(3)
  sortOrder    Int        @default(0)
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@index([curriculumId, group])
}

model StudyMaterial {
  id             String               @id @default(cuid())
  title          String
  description    String?
  topic          String?
  materialType   MaterialType         @default(LECTURE_NOTES)
  visibility     MaterialVisibility   @default(EVERYONE)
  departmentName String?
  programId      String?
  semester       Int?
  subjectId      String?
  fileName       String
  mimeType       String?
  fileSize       Int
  fileData       Bytes
  uploaderId     String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  bookmarks      Bookmark[]
  program        Program?             @relation(fields: [programId], references: [id])
  subject        Subject?             @relation(fields: [subjectId], references: [id])
  uploader       User                 @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  classLinks     StudyMaterialClass[]

  @@index([materialType])
  @@index([visibility])
  @@index([programId, semester])
  @@index([subjectId])
  @@index([uploaderId])
  @@index([createdAt])
}

model StudyMaterialClass {
  id         String        @id @default(cuid())
  materialId String
  classId    String
  class      Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  material   StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, classId])
  @@index([classId])
}

model Bookmark {
  id              String        @id @default(cuid())
  userId          String
  studyMaterialId String
  createdAt       DateTime      @default(now())
  studyMaterial   StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, studyMaterialId])
  @@index([studyMaterialId])
}

model Syllabus {
  id             String   @id @default(cuid())
  title          String?
  departmentName String
  programId      String?
  semester       Int
  fileName       String
  mimeType       String?
  fileSize       Int
  fileData       Bytes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  program        Program? @relation(fields: [programId], references: [id])

  @@index([departmentName])
  @@index([programId, semester])
  @@index([semester])
  @@index([createdAt])
}

model ProfilePrivacy {
  id         String          @id @default(cuid())
  userId     String
  fieldKey   String
  visibility FieldVisibility
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fieldKey])
  @@index([userId])
}

model AcademicYear {
  id        String             @id @default(cuid())
  name      String             @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean            @default(false)
  status    AcademicYearStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  semesters StudentSemester[]
  examSessions ExamSession[]

  @@index([isCurrent])
  @@index([status])
}

/// *
/// * Records a student's enrollment in a particular (academic year, semester).
/// * This is the source of truth for a student's academic history: advancing to a
/// * new semester creates a new row (the previous ACTIVE one becomes COMPLETED)
/// * instead of overwriting a single integer — historical enrollment is therefore
/// * always preserved.
model StudentSemester {
  id             String                @id @default(cuid())
  studentId      String
  academicYearId String
  semesterNo     Int
  startDate      DateTime?
  endDate        DateTime?
  status         StudentSemesterStatus @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  academicYear   AcademicYear          @relation(fields: [academicYearId], references: [id])
  student        Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId, semesterNo])
  @@index([studentId, status])
  @@index([academicYearId])
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

/// * Overall lifecycle state of a student's account/enrollment.
enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
  DROPPED
}

/// * A student's status within a single academic session/semester.
enum StudentSemesterStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

/// * Open/closed state of an academic year.
enum AcademicYearStatus {
  ACTIVE
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MaterialType {
  LECTURE_NOTES
  SLIDES
  QUESTION_BANK
  LAB_MANUAL
  ASSIGNMENT
  REFERENCE_MATERIAL
  PAST_PAPER
  OTHER
}

enum MaterialVisibility {
  EVERYONE
  DEPARTMENT_PROGRAM
  CLASSES
}

enum FieldVisibility {
  PUBLIC
  PRIVATE
}
