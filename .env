# Environment variables here are loaded by Next.js AND by the Prisma CLI / seed
# scripts (via prisma/load-env.ts) in `.env` → `.env.local` order, so values in
# .env.local override this file. Real credentials (cloud DB, SMTP) belong in
# .env.local (gitignored) — NEVER in this file, the repo is public.
# https://pris.ly/prisma-config-env-vars

# Local development fallback database. The Neon setup overrides this in
# .env.local with:
#   DATABASE_URL          = pooled endpoint    (app runtime: app/lib/prisma.ts)
#   DATABASE_URL_UNPOOLED = direct endpoint    (Prisma CLI: db push / migrate)
DATABASE_URL="postgresql://admin:6523@localhost:5432/college_erp?schema=public"
JWT_SECRET="secret-text-123"

# ---------------------------------------------------------------------------
# Forgot-password emails (see README "Forgot password" section).
# Leave SMTP_HOST empty to use the dev fallback: OTPs and generated passwords
# are printed to the server console instead of being emailed.
# Real credentials belong in .env.local (gitignored), NOT in this file.
# Gmail example: SMTP_HOST="smtp.gmail.com", SMTP_PORT="587",
# SMTP_USER="your.account@gmail.com", SMTP_PASS="<16-char Google App Password>"
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="College ERP <no-reply@example.com>"